+def _cef_render_child_hwnd(top_hwnd: int) -> Optional[int]:
+    """Return the first ``Chrome_RenderWidgetHostHWND`` child HWND of a window.
+
+    Embedded-Chromium hosts (WeCom's OA webview, Electron-style apps that are
+    not browsers) serve their web accessibility tree from this render-widget
+    HWND via MSAA/IA2, not through the top window's UIA tree. Pure Win32 —
+    EnumChildWindows + GetClassName — so the host's accessibility provider is
+    never entered just to decide whether to probe it. Multi-view hosts may
+    expose several render HWNDs; the first is the primary view.
+    """
+    import ctypes
+    from ctypes import wintypes
+
+    user32 = ctypes.windll.user32
+    found: list[int] = []
+    window_enum_proc = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
+    user32.EnumChildWindows.argtypes = [wintypes.HWND, window_enum_proc, wintypes.LPARAM]
+    user32.GetClassNameW.argtypes = [wintypes.HWND, wintypes.LPWSTR, wintypes.INT]
+
+    def _on_child(hwnd: int, _lparam: int) -> bool:
+        buf = ctypes.create_unicode_buffer(64)
+        user32.GetClassNameW(hwnd, buf, 64)
+        if "Chrome_RenderWidgetHostHWND" in buf.value:
+            found.append(hwnd)
+            return False
+        return True
+
+    try:
+        user32.EnumChildWindows(top_hwnd, window_enum_proc(_on_child), 0)
+    except Exception:
+        pass
+    return found[0] if found else None
+
+
